{
  "name": "vn-shelf",
  "productName": "VN Shelf",
  "version": "0.14.3",
  "description": "A local visual novel library that keeps save files in sync between computers through any synced folder.",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-tests.js",
    "dist:win": "node scripts/write-oauth-config.js && electron-builder --win --x64",
    "dist:linux": "node scripts/write-oauth-config.js && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.ychiku.vnshelf",
    "productName": "VN Shelf",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "CHANGELOG.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable"
        },
        {
          "target": "zip"
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "VN-Shelf-${version}-portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.0"
  },
  "author": {
    "name": "stagefuel"
  }
}
