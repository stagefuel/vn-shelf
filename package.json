{
  "name": "vn-shelf",
  "productName": "VN Shelf",
  "version": "0.1.0",
  "description": "A local visual novel library that keeps save files in sync between computers through any synced folder.",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.ychiku.vnshelf",
    "productName": "VN Shelf",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable"
        },
        {
          "target": "zip"
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "VN-Shelf-${version}-portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
